{
  "manifest_version": 3,
  "name": "YT Local Player",
  "version": "2.0.2",
  "description": "Ad-free native YouTube player that streams straight from YouTube, with Save, captions, SponsorBlock skipping, and ad/Shorts hiding.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "http://127.0.0.1/*",
    "https://sponsor.ajay.app/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "lib/hls.min.js",
        "lib/decipher.js",
        "lib/innertube.js",
        "lib/audio.js",
        "lib/mp4.js",
        "lib/dash-player.js",
        "lib/controls.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Local Player",
    "default_icon": {
      "16": "icons/icon-16.png",
      "19": "icons/icon-19.png",
      "32": "icons/icon-32.png",
      "38": "icons/icon-38.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  }
}
