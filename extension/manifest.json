{
  "manifest_version": 3,
  "name": "YT Local Player",
  "version": "2.0",
  "description": "Ad-free native YouTube player that streams straight from YouTube, with Save, captions, SponsorBlock skipping, and ad/Shorts hiding.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "http://127.0.0.1/*",
    "https://sponsor.ajay.app/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "lib/innertube.js",
        "lib/mp4.js",
        "lib/dash-player.js",
        "lib/controls.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Local Player"
  }
}
